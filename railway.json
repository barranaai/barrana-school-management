{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "cd railway-backend && npm ci --only=production",
    "watchPatterns": ["railway-backend/**"]
  },
  "deploy": {
    "startCommand": "cd railway-backend && npm start",
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 300
  }
}
