# Barrana.ai School Management System - Production Environment
# Rename this file to .env and update values for production deployment

# Server Configuration
NODE_ENV=production
PORT=5050
HOST=0.0.0.0
FRONTEND_URL=https://your-domain.com

# Database Configuration (Update with your production MongoDB)
MONGODB_URI=mongodb://mongo:27017/barrana_school

# JWT Configuration (CHANGE THESE IN PRODUCTION!)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-12345
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# AI Services Configuration
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=2000

# Security Configuration
BCRYPT_ROUNDS=12
RATE_LIMIT_MAX=100
SLOW_DOWN_DELAY_AFTER=5
SLOW_DOWN_DELAY_MS=500

# Logging Configuration
LOG_LEVEL=info
LOG_CONSOLE=true

# File Upload Configuration
MAX_FILE_SIZE=10485760

# Feature Flags
FEATURE_VOICE_RECORDING=true
FEATURE_AI_REPORTS=true
FEATURE_REALTIME=true
FEATURE_ANALYTICS=true
FEATURE_EMAIL=true
FEATURE_FILE_UPLOAD=true

# Business Configuration
SCHOOL_NAME=Barrana.ai School
SUPPORT_EMAIL=support@barrana.ai
ADMIN_EMAIL=admin@barrana.ai
