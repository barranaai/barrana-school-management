// @desc    Create new report template
// @route   POST /api/report-templates
// @access  Private (school_admin, super_admin)
router.post('/', protect, authorize('school_admin', 'super_admin'), async (req, res) => {
  try {
    const {
      name,
      grade,
      standards,
      reportFrequency,
      content,
      customFields,
      settings,
      isActive = true
    } = req.body;

    // Validate required fields
    if (!name || !grade || !reportFrequency) {
      return res.status(400).json({
        success: false,
        message: 'Name, grade, and report frequency are required'
      });
    }

    // Create template
    const template = await ReportTemplate.create({
      name,
      schoolId: req.user.schoolId,
      grade,
      standards: Array.isArray(standards) ? standards : standards.split(',').map(s => s.trim()),
      reportFrequency,
      content,
      customFields: customFields || [],
      settings: settings || {},
      isActive,
      createdBy: req.user._id
    });

    const populatedTemplate = await ReportTemplate.findById(template._id)
      .populate('schoolId', 'name')
      .populate('createdBy', 'firstName lastName');

    logger.info(`Report template created: ${template._id}`, {
      service: 'report-templates',
      user: req.user._id,
      templateId: template._id,
      schoolId: req.user.schoolId
    });

    res.status(201).json({
      success: true,
      message: 'Report template created successfully',
      data: populatedTemplate
    });
  } catch (error) {
    logger.error('Error creating report template', {
      service: 'report-templates',
      error: error.message,
      user: req.user._id
    });
    res.status(500).json({
      success: false,
      message: 'Error creating report template',
      error: error.message
    });
  }
});

// @desc    Update report template
// @route   PUT /api/report-templates/:id
// @access  Private (school_admin, super_admin)
router.put('/:id', protect, authorize('school_admin', 'super_admin'), async (req, res) => {
  try {
    const template = await ReportTemplate.findById(req.params.id);

    if (!template) {
      return res.status(404).json({
        success: false,
        message: 'Report template not found'
      });
    }

    // Check if user has access to this template's school
    if (req.user.role !== 'super_admin' && template.schoolId.toString() !== req.user.schoolId.toString()) {
      return res.status(403).json({
        success: false,
        message: 'Not authorized to update this template'
      });
    }

    const {
      name,
      grade,
      standards,
      reportFrequency,
      content,
      customFields,
      settings,
      isActive
    } = req.body;

    // Update template
    const updatedTemplate = await ReportTemplate.findByIdAndUpdate(
      req.params.id,
      {
        name,
        grade,
        standards: Array.isArray(standards) ? standards : standards.split(',').map(s => s.trim()),
        reportFrequency,
        content,
        customFields,
        settings,
        isActive,
        lastModified: new Date()
      },
      { new: true, runValidators: true }
    ).populate('schoolId', 'name').populate('createdBy', 'firstName lastName');

    logger.info(`Report template updated: ${req.params.id}`, {
      service: 'report-templates',
      user: req.user._id,
      templateId: req.params.id
    });

    res.json({
      success: true,
      message: 'Report template updated successfully',
      data: updatedTemplate
    });
  } catch (error) {
    logger.error('Error updating report template', {
      service: 'report-templates',
      error: error.message,
      user: req.user._id,
      templateId: req.params.id
    });
    res.status(500).json({
      success: false,
      message: 'Error updating report template',
      error: error.message
    });
  }
});

// @desc    Delete report template
// @route   DELETE /api/report-templates/:id
// @access  Private (school_admin, super_admin)
router.delete('/:id', protect, authorize('school_admin', 'super_admin'), async (req, res) => {
  try {
    const template = await ReportTemplate.findById(req.params.id);

    if (!template) {
      return res.status(404).json({
        success: false,
        message: 'Report template not found'
      });
    }

    // Check if user has access to this template's school
    if (req.user.role !== 'super_admin' && template.schoolId.toString() !== req.user.schoolId.toString()) {
      return res.status(403).json({
        success: false,
        message: 'Not authorized to delete this template'
      });
    }

    await ReportTemplate.findByIdAndDelete(req.params.id);

    logger.info(`Report template deleted: ${req.params.id}`, {
      service: 'report-templates',
      user: req.user._id,
      templateId: req.params.id
    });

    res.json({
      success: true,
      message: 'Report template deleted successfully'
    });
  } catch (error) {
    logger.error('Error deleting report template', {
      service: 'report-templates',
      error: error.message,
      user: req.user._id,
      templateId: req.params.id
    });
    res.status(500).json({
      success: false,
      message: 'Error deleting report template',
      error: error.message
    });
  }
});

// @desc    Get templates by grade
// @route   GET /api/report-templates/grade/:grade
// @access  Private (school_admin, super_admin, teacher)
router.get('/grade/:grade', protect, authorize('school_admin', 'super_admin', 'teacher'), async (req, res) => {
  try {
    const { grade } = req.params;
    const query = { grade, isActive: true };

    if (req.user.role !== 'super_admin') {
      query.schoolId = req.user.schoolId;
    }

    const templates = await ReportTemplate.find(query)
      .populate('schoolId', 'name')
      .sort({ createdAt: -1 });

    logger.info(`Report templates retrieved for grade: ${grade}`, {
      service: 'report-templates',
      user: req.user._id,
      grade,
      count: templates.length
    });

    res.json({
      success: true,
      count: templates.length,
      data: templates
    });
  } catch (error) {
    logger.error('Error retrieving templates by grade', {
      service: 'report-templates',
      error: error.message,
      user: req.user._id,
      grade: req.params.grade
    });
    res.status(500).json({
      success: false,
      message: 'Error retrieving templates by grade',
      error: error.message
    });
  }
});

