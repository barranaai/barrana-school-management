# Railway-specific Dockerfile for Backend Only
FROM node:18-alpine

# Set working directory
WORKDIR /app

# Copy the isolated backend directory
COPY railway-backend/ ./

# Install dependencies (no conflicts since this is isolated backend)
RUN npm ci --only=production

# Create upload directories
RUN mkdir -p uploads/audio uploads/media uploads/logos

# Expose port
EXPOSE 5050

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD curl -f http://localhost:5050/api/health || exit 1

# Start the application
CMD ["npm", "start"]
