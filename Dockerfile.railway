# Railway-specific Dockerfile for Backend Only
FROM node:18-slim

# Set working directory
WORKDIR /app

# Install system dependencies if needed
RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy the clean package.json for Railway
COPY package.railway.json ./package.json

# Install dependencies (no conflicts since this is backend-only)
RUN npm ci --only=production

# Copy the isolated backend directory
COPY railway-backend/ ./

# Create upload directories
RUN mkdir -p uploads/audio uploads/media uploads/logos

# Expose port
EXPOSE 5050

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD curl -f http://localhost:5050/api/health || exit 1

# Start the application
CMD ["npm", "start"]
