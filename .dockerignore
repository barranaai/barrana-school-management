# Exclude everything except railway-backend
*
!railway-backend/
!railway.json
!package.railway.json

# Exclude node_modules and other unnecessary files
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Exclude build artifacts
build/
dist/

# Exclude environment files
.env*
!.env.example

# Exclude IDE files
.vscode/
.idea/

# Exclude OS files
.DS_Store
Thumbs.db

# Exclude logs
*.log
logs/

# Exclude temporary files
*.tmp
*.temp

# Exclude large files
*.zip
*.tar.gz
*.rar

# Exclude Docker files (we're using Nixpacks)
Dockerfile*
docker-compose*
